# Plantilla de variables de entorno — Organizador Personal (AppFinanciera)
#
# Copiar a `.env.local` y completar con los valores del proyecto de Firebase.
# Este archivo versiona solo los NOMBRES de las variables: nunca incluir valores
# reales ni claves. `.env.local` no se versiona (ver `.gitignore`).

# Firebase — consola del proyecto → Configuración del proyecto → Tus apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional — va en `.env.development.local`, no en `.env.local`.
# Conecta `next dev` al emulador de Firestore. Doble guarda: `next build` y
# Vercel nunca conectan el emulador.
# NEXT_PUBLIC_USE_EMULATOR=true
